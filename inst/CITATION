# CRAN stamps Date/Publication; before that, use DESCRIPTION's Date, then the
# first release year, so the cited year never drifts with the calendar.
year <- if (!is.null(meta$`Date/Publication`)) {
  substr(meta$`Date/Publication`, 1, 4)
} else if (!is.null(meta$Date)) {
  substr(meta$Date, 1, 4)
} else {
  "2026"
}
note <- sprintf("R package version %s", meta$Version)

bibentry(
  bibtype  = "Misc",
  header   = "To cite the sdvmodels R package in publications, use:",
  key      = "gilani_sdvmodels",
  author   = person("Saiem", "Gilani", comment = c(ORCID = "0000-0002-7194-9067")),
  title    = "sdvmodels: Models for the SportsDataverse Packages.",
  url      = "https://sdvmodels.sportsdataverse.org/",
  year     = year,
  note     = note,
  textVersion = paste0(
    "Saiem Gilani (", year, "). sdvmodels: Models for the SportsDataverse ",
    "Packages. ", note, ". Retrieved from https://sdvmodels.sportsdataverse.org/"
  )
)
